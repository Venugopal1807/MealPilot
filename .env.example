# Examples only. The application reads process environment, not this file.
MEALPILOT_INTENT_BACKEND=deterministic
# Explicitly select gemini only when you intend to send user text externally.
GEMINI_API_KEY=
# Select a currently available model supporting structured JSON output.
MEALPILOT_GEMINI_MODEL=
# Socket inactivity timeout in seconds, 0.01 to 60; not a total deadline.
MEALPILOT_LLM_TIMEOUT_SECONDS=10
